# Configuration for the Python server (server/main.py).
#
# The native macOS app needs none of this — it has no configuration file and no
# environment. This file is only for the legacy FastAPI server under server/.
#
# Copy to .env and pass it to uvicorn, which loads it via python-dotenv:
#
#     cp .env.example .env
#     ./.venv/bin/uvicorn server.main:app --env-file .env --host 127.0.0.1 --port 8000
#
# Or export the variables yourself — nothing reads .env implicitly.
# Every value below is a default that already works; .env only overrides them.
# There are no secrets, accounts or API keys anywhere in this project.

# WhisperKit model id to load at startup.
#
# Read docs/FINDINGS.md finding 1 before changing this. WhisperKit's `_turbo`
# suffix marks a compute variant, NOT OpenAI's large-v3-turbo — that one is
# published under its date stamp, `large-v3-v20240930`. Name-matching
# "large-v3-turbo" gets you a different, much slower model.
#
# See server/models.py for the catalogue of ids this accepts.
ASR_MODEL=openai_whisper-large-v3-v20240930_turbo

# Maximum concurrent live transcription sessions. Sessions past the cap are
# refused with an `at_capacity` error rather than queued.
#
# One session already uses most of one model instance, so the useful ceiling is
# low. Measured degradation is in docs/FINDINGS.md finding 7: partial latency
# holds to 4 streams, but commits per stream fall by about a third.
ASR_MAX_SESSIONS=3
