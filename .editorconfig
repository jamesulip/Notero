# Indentation and line endings, so a contributor's editor matches the tree.
# No file in this repository uses tabs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,resolved,html,js,css}]
indent_size = 2

[*.md]
# Markdown uses trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
